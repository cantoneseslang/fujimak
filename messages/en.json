  "troubleshooting": {
    "pageTitle": "Fixed Q&A Troubleshooting",
    "cardTitle": "Fujimak Fixed Q&A",
    "cardDescription": "Use fixed questions to isolate the issue. If unresolved, escalate to customer call in one tap.",
    "answer": {
      "yes": "Yes",
      "no": "No"
    },
    "actions": {
      "escalate": "Unresolved: proceed to Customer Call",
