      "result": "Result"
    },
    "fallback": {
      "escalate": "Please escalate this inspection result to maintenance support."
    },
    "symptoms": {
      "cooling": {
        "title": "Insufficient Cooling",
        "description": "When refrigeration/freezing equipment is not cooling.",
        "fallback": "Cooling issue continues. Please escalate with equipment model and current condition.",
        "steps": {
          "power": {
            "question": "Is the power indicator lamp on?",
            "noResolution": "Check power plug, breaker, and main power, then turn on again."
          },
          "door": {
            "question": "Is the door fully closed and gasket undamaged?",
            "noResolution": "Adjust door closure and remove foreign objects."
          },
          "airflow": {
            "question": "Are air inlets/outlets free from blockage?",
            "noResolution": "Keep at least 30 cm clearance around airflow ports and recheck."
          }
        }
      },
      "waterLeak": {
        "title": "Water Leak",
        "description": "Leakage around piping or drain area.",
        "fallback": "Leak source needs identification. Please escalate with photos of the leakage area.",
        "steps": {
          "valve": {
            "question": "Have you confirmed the shut-off valve is not loose?",
            "noResolution": "Tighten the valve and confirm whether leakage stops."
          },
          "drain": {
            "question": "Is there any clog in the drain hose or trap?",
            "noResolution": "Remove clogging and secure the drainage path."
          },
          "joint": {
            "question": "Are nuts/clamps at connections free from looseness?",
            "noResolution": "Retighten connection points and verify again."
          }
        }
      },
      "noise": {
        "title": "Abnormal Noise / Vibration",
        "description": "When equipment produces unusual sound or vibration.",
        "fallback": "Motor/compressor inspection is required. Please escalate with a video.",
        "steps": {
          "foreign": {
            "question": "Is there any contact with surrounding objects (cover, wiring, tools)?",
            "noResolution": "Remove foreign contact and restart in a clear state."
          },
          "level": {
            "question": "Is the equipment installed level?",
            "noResolution": "Adjust leveling and confirm if vibration improves."
          },
          "fan": {
            "question": "Does fan/motor rotation sound change intermittently?",
            "noResolution": "Stop temporarily, restart, and confirm recurrence."
          }
        }
      }
    }
  },
